# Frontend env (safe to ship — these are Supabase PUBLIC/publishable values, like
# the anon key; they're meant for the browser). Copy to `.env` and fill in.
# Edge-function secrets (RUMIK_API_KEY, VAPI_API_KEY, etc.) do NOT go here —
# set them in Supabase (Dashboard → Project Settings → Edge Functions → Secrets).
# Set APP_ALLOWED_ORIGINS as an edge-function secret (comma-separated) when
# deploying Vapi, for example: https://hajjcare.in,https://www.hajjcare.in

VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-ANON-KEY"

# Optional Firebase public web configuration. These values identify the web
# app and are safe to expose to the browser; never put a Firebase Admin SDK or
# service-account key in a VITE_ variable.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
# When true, sign-up/sign-in/password-reset are also synchronized to Firebase
# while Supabase remains the current session and database authority.
VITE_FIREBASE_AUTH_ENABLED="false"

# Public HTTPS endpoint for a versioned changelog JSON document. It must return
# Access-Control-Allow-Origin for hajjcare.in (and any preview domains).
# When unset or unavailable, the app uses its bundled release-note fallback.
# VITE_CHANGELOG_URL="https://cms.example.com/hajcare/changelog.json"

# Optional public links shown after a successful Free Hajj Training registration.
# Leave unset until the official community and approved training schedule are live.
# VITE_HAJCARE_TRAINING_WHATSAPP_URL="https://chat.whatsapp.com/..."
# VITE_HAJCARE_TRAINING_TELEGRAM_URL="https://t.me/..."
# VITE_HAJCARE_TRAINING_SCHEDULE_URL="https://hajjcare.in/documents/training-schedule.pdf"
