{
  "redirects": [
    { "source": "/training", "destination": "/classroom", "permanent": false },
    { "source": "/100-days", "destination": "/classroom", "permanent": false },
    { "source": "/100-day", "destination": "/classroom", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/explore", "destination": "/explore.html" },
    { "source": "/library", "destination": "/library.html" },
    { "source": "/library/hajj-aur-umrah-kai-masail", "destination": "/kitab/reader.html" },
    { "source": "/visitors", "destination": "/visitors.html" },
    { "source": "/auth", "destination": "/app.html" },
    { "source": "/volunteer/training", "destination": "/app.html" },
    { "source": "/volunteer", "destination": "/app.html" },
    { "source": "/service-fee", "destination": "/app.html" },
    { "source": "/classroom/day/:day/card", "destination": "/app.html" },
    { "source": "/classroom/day/:day", "destination": "/app.html" },
    { "source": "/classroom/admin", "destination": "/app.html" },
    { "source": "/classroom", "destination": "/app.html" },
    { "source": "/admin/classroom", "destination": "/app.html" },
    { "source": "/reset-password", "destination": "/app.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/privacy", "destination": "/privacy-policy.html" },
    { "source": "/account-deletion", "destination": "/privacy-policy.html" },
    { "source": "/sukoon", "destination": "/sukoon.html" },
    { "source": "/((?!videos/|api/|kitab/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/kitab/(.*\\.pdf)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
