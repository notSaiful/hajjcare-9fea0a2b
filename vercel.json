{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/explore", "destination": "/explore.html" },
    { "source": "/library", "destination": "/library.html" },
    { "source": "/visitors", "destination": "/visitors.html" },
    { "source": "/auth", "destination": "/app.html" },
    { "source": "/volunteer/training", "destination": "/app.html" },
    { "source": "/volunteer", "destination": "/app.html" },
    { "source": "/service-fee", "destination": "/app.html" },
    { "source": "/reset-password", "destination": "/app.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/privacy", "destination": "/privacy-policy.html" },
    { "source": "/account-deletion", "destination": "/privacy-policy.html" },
    { "source": "/((?!videos/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    }
  ]
}
